# Generated data and vendored browser libraries: never in git.
# `data` is a symlink to the aiqclib output tree, so match it without a
# trailing slash (a trailing slash would only match a real directory).
data
# Written by scripts/make_demo_data.py. It sits beside `data` rather than
# inside it because `data` is that symlink, and writing the synthetic inputs
# into it would mean writing into the real aiqclib output tree.
demo-data/
site/data/
site/libs/
site/_site/
site/.quarto/
# Written by `quarto render`; the paths in it are already covered above.
site/.gitignore
_site/
.quarto/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Editors and OS
.idea/
.vscode/
.DS_Store

# Appended by `quarto render` itself, which maintains these entries. The
# first is already covered above; the second is the notebook it writes while
# executing a page.
/.quarto/
**/*.quarto_ipynb
